<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5">

	<LinearLayout
        android:id="@+id/filterArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

		<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Find a Court"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginBottom="12dp"/>

		<EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="Search by name"
            android:background="@android:drawable/editbox_background_normal"
            android:paddingLeft="15dp"
            android:textSize="14sp" />
	</LinearLayout>

	<ListView
        android:id="@+id/lvFields"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/filterArea"
        android:layout_above="@+id/bottomNavigation"
        android:divider="@android:color/transparent"
        android:dividerHeight="12dp"
        android:padding="12dp"
        android:clipToPadding="false" />

	<LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:background="#D1D9E0"
        android:orientation="horizontal"
        android:weightSum="3"
        android:elevation="10dp">

		<LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">
			<ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/home" />
			<TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="11sp"
                android:textColor="#4A4A4A" />
		</LinearLayout>

		<LinearLayout
            android:id="@+id/navNew"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">
			<ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/calendar" />
			<TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Reservation"
                android:textSize="11sp"
                android:textColor="#4A4A4A" />
		</LinearLayout>

		<LinearLayout
            android:id="@+id/navAccount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">
			<ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/account" />
			<TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account"
                android:textSize="11sp"
                android:textColor="#4A4A4A" />
		</LinearLayout>
	</LinearLayout>

</RelativeLayout>